---
import Reveal from '../islands/Reveal';
import Button from '../ui/Button.astro';
import { posts } from '../../data/site';
interface Props { limit?: number }
const { limit } = Astro.props;
const list = limit ? posts.slice(0, limit) : posts;
---
<section id="blog" class="bg-ivory px-6 py-24 lg:px-10 lg:py-36">
  <div class="mx-auto max-w-[1400px]">
    <Reveal client:visible>
      <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
        <div>
          <p class="eyebrow">From the blog</p>
          <h2 class="mt-5 text-[clamp(2.4rem,5vw,4.4rem)]">Foot health, <em class="text-gold">explained.</em></h2>
        </div>
        <Button href="/blog" variant="outline" class="text-navy-900">All articles</Button>
      </div>
    </Reveal>

    <div class="mt-14 grid gap-10 md:grid-cols-3">
      {list.map((p) => (
        <Reveal client:visible>
          <article class="group">
            <a href={`/blog/${p.slug}`} class="block">
              <div class="photo relative aspect-square">
                <img src={p.img} alt="" loading="lazy" width="800" height="800" onerror="this.style.display='none'" class="transition-transform duration-[1400ms] group-hover:scale-105" />
              </div>
              <div class="mt-6 flex items-center gap-4 text-xs uppercase tracking-[0.22em] text-navy-900/60">
                <span class="text-gold">{p.category}</span><span aria-hidden="true">·</span><span>{p.readTime}</span>
              </div>
              <h3 class="mt-3 text-[1.9rem] transition-colors duration-300 group-hover:text-navy-700">{p.title}</h3>
              <p class="mt-3 text-navy-900/70">{p.excerpt}</p>
              <span class="link-line mt-5 inline-block text-xs uppercase tracking-[0.2em]">Read more →</span>
            </a>
          </article>
        </Reveal>
      ))}
    </div>
  </div>
</section>
