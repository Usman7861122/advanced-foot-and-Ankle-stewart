---
import Reveal from '../islands/Reveal';
import Button from '../ui/Button.astro';
const causes = [
  { t: 'Plantar fasciitis', d: 'The band under your foot gets sore. Pain is often worst with the first steps in the morning.' },
  { t: 'Heel spur', d: 'A small bony growth that can build up near the heel and press on soft tissue.' },
  { t: 'Achilles tendon strain', d: 'Pain at the back of the heel, common in runners and active people.' },
  { t: 'Stress or bone injury', d: 'Ache that grows with activity and eases with rest. It needs a proper exam.' },
];
const signs = ['Sharp pain with the first steps of the day', 'Ache after standing or walking for long', 'Soreness in the arch or the back of the heel', 'Pain that has lasted more than a few weeks'];
const care = [
  { t: 'Careful exam', d: 'We ask about your day, your shoes and your activity, then check your foot closely.' },
  { t: 'Clear diagnosis', d: 'In-office technology helps us find the true cause, not just treat the pain.' },
  { t: 'Gentle care first', d: 'Stretching, supports, custom orthotics and MLS laser therapy come before anything else.' },
  { t: 'Surgery only if needed', d: 'Most heel pain improves without it. If surgery helps, we use minimally invasive methods.' },
];
const faqs = [
  { q: 'Why does my heel hurt most in the morning?', a: 'After rest, the tissue under your foot tightens. The first steps stretch it fast, and that can hurt. It often eases as you move.' },
  { q: 'Will I need surgery?', a: 'Most people do not. Simple care works for the large majority. We talk about surgery only if other options have not helped.' },
  { q: 'When should I see a podiatrist?', a: 'If heel pain lasts more than a couple of weeks, keeps coming back, or you cannot walk normally, book a visit. Sudden swelling or bruising should be checked soon.' },
  { q: 'Can I keep exercising?', a: 'Often yes, with changes. We will tell you which activities are safe while you heal.' },
];
---
<section class="bg-ivory px-6 py-24 lg:px-10 lg:py-32">
  <div class="mx-auto grid max-w-[1400px] items-center gap-14 lg:grid-cols-[1fr_1fr] lg:gap-24">
    <Reveal client:visible>
      <p class="eyebrow">Understanding heel pain</p>
      <h2 class="mt-5 text-[clamp(2.2rem,4.6vw,3.8rem)] text-navy-900">Pain with your first step? <em class="text-gold">You are not alone.</em></h2>
      <p class="mt-6 max-w-xl text-lg text-navy-900/75">Heel pain is one of the most common foot problems we see. The good news: it is very treatable once we know the cause.</p>
      <ul class="mt-8 space-y-3">
        {signs.map((s) => (
          <li class="flex gap-4 border-b border-navy-900/10 pb-3 text-navy-900/80"><span class="mt-[0.7em] h-px w-6 shrink-0 bg-gold"></span>{s}</li>
        ))}
      </ul>
    </Reveal>
    <Reveal client:visible>
      <div class="relative">
        <div class="absolute -bottom-5 -left-5 hidden h-full w-full border border-gold/60 sm:block" style="border-radius:3px"></div>
        <img src="/images/heel-pain-symptom.jpg" alt="Woman holding her sore heel at home" loading="lazy" class="photo relative aspect-[4/3] w-full object-cover" />
      </div>
    </Reveal>
  </div>
</section>

<section class="bg-navy-950 px-6 py-24 text-white lg:px-10 lg:py-32">
  <div class="mx-auto max-w-[1400px]">
    <Reveal client:visible>
      <p class="eyebrow">Common causes</p>
      <h2 class="mt-5 max-w-2xl text-[clamp(2.2rem,4.6vw,3.8rem)]">Finding the <em class="text-gold">real reason.</em></h2>
    </Reveal>
    <ul class="mt-14 grid gap-px bg-white/15 sm:grid-cols-2 lg:grid-cols-4">
      {causes.map((c, i) => (
        <li class="bg-navy-950 p-8 transition-colors duration-500 hover:bg-navy-900">
          <span class="font-serif text-4xl text-gold/70">0{i + 1}</span>
          <h3 class="mt-4 text-2xl">{c.t}</h3>
          <p class="mt-3 text-white/70">{c.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="bg-ivory px-6 py-24 lg:px-10 lg:py-32">
  <div class="mx-auto grid max-w-[1400px] items-center gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24">
    <Reveal client:visible>
      <div class="relative">
        <div class="absolute -bottom-5 -right-5 hidden h-full w-full border border-gold/60 sm:block" style="border-radius:3px"></div>
        <img src="/images/heel-pain-exam.jpg" alt="Podiatrist examining a patient's foot" loading="lazy" class="photo relative aspect-[4/3] w-full object-cover" />
      </div>
    </Reveal>
    <Reveal client:visible>
      <p class="eyebrow">How we treat it</p>
      <h2 class="mt-5 text-[clamp(2.2rem,4.6vw,3.8rem)] text-navy-900">Simple care first, <em class="text-gold">every time.</em></h2>
      <ol class="mt-8 divide-y divide-navy-900/15 border-y border-navy-900/15">
        {care.map((x, i) => (
          <li class="grid grid-cols-[auto_1fr] gap-5 py-5">
            <span class="font-serif text-3xl text-gold">0{i + 1}</span>
            <div><h3 class="text-xl text-navy-900">{x.t}</h3><p class="mt-1 text-navy-900/70">{x.d}</p></div>
          </li>
        ))}
      </ol>
      <div class="mt-9 flex flex-wrap gap-4"><Button book variant="book-dark">Book Appointment</Button><Button href="/services/mls-laser-therapy" variant="outline">About MLS laser</Button></div>
    </Reveal>
  </div>
</section>

<section class="relative isolate overflow-hidden bg-navy-950 text-white">
  <img src="/images/heel-pain-recovery.jpg" alt="Foot rolling on a therapy ball during a stretch" loading="lazy" class="absolute inset-0 -z-20 h-full w-full object-cover" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[#060f24]/95 via-[#0b1d42]/80 to-[#060f24]/35"></div>
  <div class="mx-auto max-w-[1400px] px-6 py-24 lg:px-10 lg:py-36">
    <Reveal client:visible>
      <p class="eyebrow">Recovery</p>
      <h2 class="mt-5 max-w-2xl text-[clamp(2.2rem,5vw,4rem)]">Small daily habits, <em class="text-gold">big relief.</em></h2>
      <p class="mt-6 max-w-xl text-lg text-white/75">Gentle stretches, supportive shoes and rolling your arch can speed healing. We will show you what to do and how often.</p>
      <div class="mt-9"><Button book variant="book">Book Appointment</Button></div>
    </Reveal>
  </div>
</section>

<section class="bg-ivory px-6 py-24 lg:px-10 lg:py-32">
  <div class="mx-auto max-w-3xl">
    <Reveal client:visible>
      <p class="eyebrow text-center">Questions</p>
      <h2 class="mt-5 text-center text-[clamp(2rem,4vw,3.2rem)] text-navy-900">Heel pain, <em class="text-gold">answered.</em></h2>
    </Reveal>
    <div class="mt-12 divide-y divide-navy-900/15 border-y border-navy-900/15">
      {faqs.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-serif text-2xl text-navy-900">{f.q}<span class="text-gold transition-transform group-open:rotate-45">+</span></summary>
          <p class="mt-3 max-w-2xl text-navy-900/70">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
