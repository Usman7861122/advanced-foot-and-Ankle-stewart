---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';

interface Props {
  title: string; eyebrow?: string; lede?: string; description?: string;
  image?: string; imageAlt?: string; position?: string; noindex?: boolean;
}
const { title, eyebrow, lede, description, image, imageAlt, position, noindex } = Astro.props;
---
<BaseLayout title={`${title} | Advanced Foot & Ankle Specialists`} description={description ?? lede} noindex={noindex}>
  <PageHero {title} {eyebrow} {lede} {image} {imageAlt} {position} />
  <slot />
</BaseLayout>
