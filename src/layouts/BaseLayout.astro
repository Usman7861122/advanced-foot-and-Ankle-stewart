---
import '../styles/global.css';
import Header from '../components/islands/Header';
import Footer from '../components/sections/Footer.astro';
import CookieConsent from '../components/ui/CookieConsent.astro';
import { site } from '../data/site';

interface Props { title?: string; description?: string; noindex?: boolean; ogImage?: string }
const {
  title = `Podiatrist in Chandler, AZ | ${site.clinic}`,
  description = site.description,
  noindex = false,
  ogImage = '/images/hero-1-runner.jpg',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const og = new URL(ogImage, Astro.site ?? site.url);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.clinic} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b1d42" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=DM+Sans:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-white focus:px-4 focus:py-2">Skip to content</a>
    <Header client:load />
    <main id="main"><slot /></main>
    <Footer />
    <CookieConsent />
  </body>
</html>
