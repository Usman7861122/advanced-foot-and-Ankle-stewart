---
import PageLayout from '../../layouts/PageLayout.astro';
import Contact from '../../components/home/Contact.astro';
import Reveal from '../../components/islands/Reveal';
import Button from '../../components/ui/Button.astro';
import { conditions } from '../../data/conditions';
import { topicFor } from '../../data/topics';
const groups = [...new Set(conditions.map((c) => c.group))];
const slugify = (g: string) => g.toLowerCase().replace(/[^a-z]+/g, '-');
const intro: Record<string, string> = {
  'Heel & Arch': 'Pain under the heel and arch, and feet that tire easily.',
  'Toes & Forefoot': 'Bumps, nails and pain in the front of the foot.',
  'Ankle & Tendons': 'Twists, sprains and sore or torn tendons.',
  'Nerves, Skin & Joints': 'Nerve changes, skin and nail problems, and painful joints.',
};
const photo = (slug: string) => {
  if (slug === 'plantar-fasciitis') return '/images/pf-insole.jpg';
  const t = topicFor(slug);
  return t ? `/images/${t.prefix}-${(t.order ?? [1, 2, 3])[0]}.jpg` : '/images/heel-pain-exam.jpg';
};
---
<PageLayout title="Conditions We Treat" eyebrow="Foot & ankle conditions" lede="Not sure what is causing your pain? Start here to learn about common foot and ankle problems, then book a visit for clear answers." image="/images/heel-pain-exam.jpg">
  <section class="bg-ivory px-6 py-20 lg:px-10 lg:py-28">
    <div class="mx-auto max-w-[1400px]">
      <nav aria-label="Condition groups" class="mb-16 flex flex-wrap gap-3">
        {groups.map((g) => <a href={`#${slugify(g)}`} class="btn btn-outline !border-navy-900/30 !text-navy-900">{g}</a>)}
      </nav>
      {groups.map((g) => (
        <div id={slugify(g)} class="scroll-mt-32 pb-20 last:pb-0">
          <Reveal client:visible>
            <p class="eyebrow">{conditions.filter((c) => c.group === g).length} conditions</p>
            <h2 class="mt-3 text-[clamp(2.2rem,4.4vw,3.6rem)] text-navy-900">{g}</h2>
            <p class="mt-3 max-w-xl text-navy-900/70">{intro[g]}</p>
          </Reveal>
          <ul class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
            {conditions.filter((c) => c.group === g).map((c) => (
              <li id={c.slug}>
                <a href={`/conditions/${c.slug}`} class="group block">
                  <div class="relative overflow-hidden" style="border-radius:3px">
                    <img src={photo(c.slug)} alt={`${c.title} care`} loading="lazy" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-105" />
                    <div class="absolute inset-0 bg-gradient-to-t from-navy-950/50 via-transparent to-transparent"></div>
                  </div>
                  <h3 class="mt-5 font-serif text-3xl text-navy-900 transition-colors group-hover:text-gold">{c.title}</h3>
                  <p class="mt-2 text-navy-900/70">{c.summary}</p>
                  <span class="mt-3 inline-block text-sm tracking-wide text-gold">Learn more <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
  <section class="bg-navy-950 px-6 py-20 text-center text-white lg:px-10">
    <p class="eyebrow">Do not see your problem?</p>
    <h2 class="mx-auto mt-4 max-w-2xl text-[clamp(2rem,4vw,3.2rem)]">We treat the whole foot and ankle. <em class="text-gold">Just ask.</em></h2>
    <div class="mt-8 flex flex-wrap justify-center gap-4"><Button book variant="book">Book Appointment</Button><Button href="/services" variant="outline">See all services</Button></div>
  </section>
  <Contact />
</PageLayout>
