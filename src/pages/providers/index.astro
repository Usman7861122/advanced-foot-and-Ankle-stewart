---
import PageLayout from '../../layouts/PageLayout.astro';
import Contact from '../../components/home/Contact.astro';
import Reveal from '../../components/islands/Reveal';
import Button from '../../components/ui/Button.astro';
import { providers } from '../../data/site';
const last = (n: string) => n.replace(/, DPM$/, '').split(' ').slice(-1)[0];
const points = [
  { t: 'Two surgeons, one plan', d: 'Both doctors know your case, so you always get a clear, shared plan.' },
  { t: 'Simple care first', d: 'Supports, therapy and MLS laser come before surgery. Surgery only when it is the right choice.' },
  { t: 'Care close to home', d: 'Serving Chandler and nearby areas since 1998, with urgent help for sports injuries.' },
];
---
<PageLayout title="Our Providers" eyebrow="Meet the team" lede="Two board-certified podiatrists and surgeons who plan your care together. Get to know their training, their focus and how they care for you." image="/images/hero-3-clinic.jpg">
  <section class="bg-ivory px-6 py-20 lg:px-10 lg:py-28">
    <div class="mx-auto max-w-[1400px] space-y-24 lg:space-y-32">
      {providers.map((p, i) => (
        <div class:list={["grid items-center gap-12 lg:grid-cols-2 lg:gap-24"]}>
          <div class:list={[i % 2 === 1 && "lg:order-2"]}>
          <Reveal client:visible>
            <div class="relative">
              <div class:list={["absolute -bottom-5 hidden h-full w-full border border-gold/60 sm:block", i % 2 === 1 ? "-right-5" : "-left-5"]} style="border-radius:3px"></div>
              <img src={p.img} alt={`Portrait of ${p.name}`} loading="lazy" class="photo relative aspect-[4/5] w-full object-cover object-[50%_12%]" />
            </div>
          </Reveal>
          </div>
          <div>
          <Reveal client:visible>
            <p class="eyebrow">{p.role}</p>
            <h2 class="mt-4 text-[clamp(2.4rem,4.6vw,4rem)] text-navy-900">{p.name}</h2>
            <div class="hairline my-6 w-20"></div>
            <p class="max-w-xl text-lg text-navy-900/75">{p.short}</p>
            <p class="mt-5 text-xs uppercase tracking-[0.18em] text-navy-900/55">{p.creds}</p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {p.focus.map((f) => <li class="rounded-[4px] border border-navy-900/25 px-3 py-1 text-xs tracking-wide text-navy-900/80">{f}</li>)}
            </ul>
            <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
              <Button book variant="book-dark">Book with Dr. {last(p.name)}</Button>
              <a href={`/providers/${p.slug}`} class="link-line text-xs uppercase tracking-[0.2em] text-navy-900">Full profile →</a>
            </div>
          </Reveal>
          </div>
        </div>
      ))}
    </div>
  </section>
  <section class="bg-navy-950 px-6 py-24 text-white lg:px-10 lg:py-32">
    <div class="mx-auto max-w-[1400px]">
      <Reveal client:visible>
        <p class="eyebrow">Our approach</p>
        <h2 class="mt-5 max-w-2xl text-[clamp(2.2rem,4.6vw,3.8rem)]">One team, <em class="text-gold">one clear plan.</em></h2>
      </Reveal>
      <ul class="mt-14 grid gap-px bg-white/15 md:grid-cols-3">
        {points.map((x, i) => (
          <li class="bg-navy-950 p-8 transition-colors duration-500 hover:bg-navy-900">
            <span class="font-serif text-4xl text-gold/70">0{i + 1}</span>
            <h3 class="mt-4 text-2xl">{x.t}</h3>
            <p class="mt-3 text-white/70">{x.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <Contact />
</PageLayout>
