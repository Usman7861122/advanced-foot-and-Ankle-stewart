---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import { posts } from '../../data/site';
const cats = [...new Set(posts.map((p) => p.category))];
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const [lead, ...rest] = posts;
---
<PageLayout title="Blog" eyebrow="Foot health" lede="Plain-English advice from our podiatrists. Tips on foot pain, healthy habits and when to see a doctor, written to be easy to read." image="/images/heel-pain-exam.jpg">
  <section class="bg-ivory px-6 py-20 lg:px-10 lg:py-28">
    <div class="mx-auto max-w-[1400px]">
      <a href={`/blog/${lead.slug}`} class="group grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="photo aspect-[4/3] overflow-hidden"><img src={lead.img} alt="" class="h-full w-full object-cover transition-transform duration-[1400ms] group-hover:scale-105" /></div>
        <div>
          <p class="eyebrow">Latest article</p>
          <p class="mt-4 text-xs uppercase tracking-[0.2em] text-navy-900/60"><span class="text-gold">{lead.category}</span> · {fmt(lead.date)} · {lead.readTime}</p>
          <h2 class="mt-4 text-[clamp(2rem,3.6vw,3.2rem)] text-navy-900 transition-colors group-hover:text-gold">{lead.title}</h2>
          <p class="mt-4 max-w-xl text-lg text-navy-900/70">{lead.excerpt}</p>
          <span class="link-line mt-6 inline-block text-xs uppercase tracking-[0.2em]">Read article →</span>
        </div>
      </a>

      <div class="mt-20 flex flex-wrap items-center gap-3" role="group" aria-label="Filter articles">
        <button type="button" data-cat="all" class="cat-chip btn btn-outline !border-navy-900/30 !text-navy-900" aria-pressed="true">All ({posts.length})</button>
        {cats.map((c) => <button type="button" data-cat={c} class="cat-chip btn btn-outline !border-navy-900/30 !text-navy-900" aria-pressed="false">{c}</button>)}
      </div>

      <ul class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" id="post-grid">
        {rest.map((p) => (
          <li data-cat={p.category}>
            <a href={`/blog/${p.slug}`} class="group block">
              <div class="photo aspect-[4/3] overflow-hidden"><img src={p.img} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" /></div>
              <p class="mt-5 text-xs uppercase tracking-[0.2em] text-navy-900/60"><span class="text-gold">{p.category}</span> · {fmt(p.date)} · {p.readTime}</p>
              <h3 class="mt-3 font-serif text-[1.7rem] leading-snug text-navy-900 transition-colors group-hover:text-gold">{p.title}</h3>
              <p class="mt-3 line-clamp-3 text-navy-900/70">{p.excerpt}</p>
              <span class="link-line mt-4 inline-block text-xs uppercase tracking-[0.2em]">Read more →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="bg-navy-950 px-6 py-20 text-center text-white lg:px-10">
    <p class="eyebrow">Have a question?</p>
    <h2 class="mx-auto mt-4 max-w-2xl text-[clamp(2rem,4vw,3.2rem)]">Ask our podiatrists. <em class="text-gold">We are happy to help.</em></h2>
    <div class="mt-8"><Button book variant="book">Book Appointment</Button></div>
  </section>
  <script is:inline>
    (function () {
      var chips = document.querySelectorAll('.cat-chip');
      var items = document.querySelectorAll('#post-grid > li');
      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          var c = chip.getAttribute('data-cat');
          chips.forEach(function (x) { x.setAttribute('aria-pressed', x === chip ? 'true' : 'false'); x.style.background = x === chip ? '#0b1d42' : ''; x.style.color = x === chip ? '#fff' : ''; });
          items.forEach(function (li) { li.style.display = (c === 'all' || li.getAttribute('data-cat') === c) ? '' : 'none'; });
        });
      });
    })();
  </script>
</PageLayout>
