---
import PageLayout from '../layouts/PageLayout.astro';
import Reveal from '../components/islands/Reveal';
import HoursToday from '../components/ui/HoursToday.astro';
import { site } from '../data/site';
import { services } from '../data/services';
const a = site.address;
const full = `${a.street}, ${a.city}, ${a.state} ${a.zip}`;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(full)}`;
const embed = `https://www.google.com/maps?q=${encodeURIComponent(full)}&z=15&output=embed`;
const field = 'w-full rounded-[3px] border border-navy-900/25 bg-white/60 px-4 py-3.5 text-navy-900 placeholder:text-navy-900/40 focus:border-gold focus:outline-none';
const label = 'mb-2 block text-xs uppercase tracking-[0.2em] text-navy-900/65';
const steps = [
  { t: 'You send a request', d: 'Fill in the short form, or just call us. It takes about a minute.' },
  { t: 'We call you back', d: 'Our friendly team finds a time that fits your day, often the same or next day.' },
  { t: 'You meet your doctor', d: 'A careful exam, a clear answer, and a plan in plain words.' },
];
const faqs = [
  { q: 'Do I need a referral?', a: 'Please call us. Our team will tell you what your plan needs before your visit.' },
  { q: 'What should I bring?', a: 'Bring your photo ID, insurance card, a list of your medicines, and the shoes you wear most.' },
  { q: 'Do you see children?', a: 'Yes. We care for children and adults.' },
  { q: 'What if it is an emergency?', a: 'For a sports injury or trauma, call us right away. For life-threatening problems, call 911.' },
];
---
<PageLayout title="Contact & Appointments" eyebrow="Get in touch" lede="Call us or send a request. We will help you find a time that works, and answer any questions you have before your visit." image="/images/about-story.jpg">
  <!-- Quick contact cards -->
  <section class="bg-ivory px-6 pb-8 pt-16 lg:px-10 lg:pt-24">
    <ul class="mx-auto grid max-w-[1400px] gap-px bg-navy-900/15 md:grid-cols-3">
      <li class="bg-ivory p-9">
        <p class="eyebrow">Call</p>
        <a href={site.phoneHref} class="mt-4 block font-serif text-4xl text-navy-900 transition-colors hover:text-gold">{site.phone}</a>
        <p class="mt-2 text-sm text-navy-900/60">Fax {site.fax}</p>
      </li>
      <li class="bg-ivory p-9">
        <p class="eyebrow">Visit</p>
        <p class="mt-4 text-lg leading-snug text-navy-900/85">{a.street}<br />{a.city}, {a.state} {a.zip}</p>
        <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="link-line mt-3 inline-block text-xs uppercase tracking-[0.2em] text-gold">Get directions →</a>
      </li>
      <li class="bg-ivory p-9">
        <p class="eyebrow">Hours</p>
        <div class="mt-4 space-y-1.5 text-sm text-navy-900/85">
          {site.hours.map((h) => <div class="flex justify-between gap-4" data-days={h.days.join(',')}><span>{h.day}</span><span class="text-navy-900/60">{h.time}</span></div>)}
        </div>
      </li>
    </ul>
  </section>

  <!-- Form + what happens next -->
  <section class="bg-ivory px-6 py-20 lg:px-10 lg:py-28">
    <div class="mx-auto grid max-w-[1400px] gap-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-24">
      <Reveal client:visible>
        <form id="appointment" action={site.contactApi || undefined} method="post" class="scroll-mt-32 space-y-5">
          <p class="eyebrow">Request an appointment</p>
          <h2 class="text-[clamp(2.2rem,4.4vw,3.6rem)] text-navy-900">Tell us what <em class="text-gold">hurts.</em></h2>
          <div class="grid gap-5 pt-4 sm:grid-cols-2">
            <label class="block"><span class={label}>Full name</span><input class={field} type="text" name="name" autocomplete="name" required /></label>
            <label class="block"><span class={label}>Phone</span><input class={field} type="tel" name="phone" autocomplete="tel" required /></label>
          </div>
          <label class="block"><span class={label}>Email</span><input class={field} type="email" name="email" autocomplete="email" required /></label>
          <label class="block">
            <span class={label}>I am interested in</span>
            <select class={field} name="interest">
              <option value="">Choose a service</option>
              {services.map((s) => <option value={s.slug}>{s.title}</option>)}
              <option value="other">Something else</option>
            </select>
          </label>
          <label class="block"><span class={label}>Message</span><textarea class={field} name="message" rows="5"></textarea></label>
          <button type="submit" class="btn btn-book-dark w-full sm:w-auto">Request Appointment</button>
          <p class="text-xs text-navy-900/55">Please do not include private medical details. For urgent problems, call us.</p>
        </form>
      </Reveal>

      <Reveal client:visible>
        <div class="lg:sticky lg:top-32">
          <div class="relative">
            <div class="absolute -bottom-4 -right-4 hidden h-full w-full border border-gold/60 sm:block" style="border-radius:3px"></div>
            <img src="/images/about-story.jpg" alt="Our bright, welcoming clinic room" loading="lazy" class="photo relative aspect-[16/10] w-full object-cover" />
          </div>
          <p class="eyebrow mt-12">What happens next</p>
          <ol class="mt-4 divide-y divide-navy-900/15 border-y border-navy-900/15">
            {steps.map((s, i) => (
              <li class="grid grid-cols-[auto_1fr] gap-5 py-5">
                <span class="font-serif text-3xl text-gold">0{i + 1}</span>
                <div><h3 class="text-xl text-navy-900">{s.t}</h3><p class="mt-1 text-navy-900/70">{s.d}</p></div>
              </li>
            ))}
          </ol>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- Map -->
  <section class="bg-navy-950 px-6 py-20 text-white lg:px-10 lg:py-28">
    <div class="mx-auto max-w-[1400px]">
      <Reveal client:visible>
        <p class="eyebrow">Find us</p>
        <h2 class="mt-5 max-w-2xl text-[clamp(2.2rem,4.6vw,3.8rem)]">Easy to reach, <em class="text-gold">in the heart of Chandler.</em></h2>
      </Reveal>
      <div class="photo relative mt-12 h-[360px] border border-white/15 lg:h-[460px]">
        <iframe title={`Map to ${site.clinic}, ${full}`} src={embed} loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="h-full w-full border-0 [filter:grayscale(.85)_contrast(1.05)_brightness(.92)] transition duration-700 hover:[filter:none]"></iframe>
        <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline absolute bottom-4 left-4 !min-h-[44px] !bg-navy-950/90 !text-[12px]">Open in Google Maps →</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-ivory px-6 py-24 lg:px-10 lg:py-32">
    <div class="mx-auto max-w-3xl">
      <Reveal client:visible>
        <p class="eyebrow text-center">Before your visit</p>
        <h2 class="mt-5 text-center text-[clamp(2rem,4vw,3.2rem)] text-navy-900">Good to <em class="text-gold">know.</em></h2>
      </Reveal>
      <div class="mt-12 divide-y divide-navy-900/15 border-y border-navy-900/15">
        {faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-serif text-2xl text-navy-900">{f.q}<span class="text-gold transition-transform group-open:rotate-45">+</span></summary>
            <p class="mt-3 max-w-2xl text-navy-900/70">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <HoursToday />
</PageLayout>
