---
import PageLayout from '../../layouts/PageLayout.astro';
import Contact from '../../components/home/Contact.astro';
import Reveal from '../../components/islands/Reveal';
import Button from '../../components/ui/Button.astro';
import { services } from '../../data/services';
import { topics } from '../../data/topics';
const groups = [...new Set(services.map((s) => s.group))];
const intro: Record<string, string> = {
  'Pain & Injury': 'Heel, arch, ankle and joint pain, from first twinge to long-lasting problems.',
  'Skin & Nails': 'Common nail and skin problems, treated quickly and gently.',
  'Specialty Care': 'Advanced tools and focused care for complex or long-term needs.',
};
const photo = (slug: string) =>
  slug === 'heel-pain' ? '/images/heel-pain-exam.jpg'
  : slug === 'plantar-fasciitis' ? '/images/pf-insole.jpg'
  : `/images/${topics[slug]?.prefix ?? slug}-${(topics[slug]?.order ?? [1])[0]}.jpg`;
---
<PageLayout title="Our Services" eyebrow="Foot & ankle care" lede="From everyday aches to complex surgery, we treat the whole foot and ankle, with simple care first. Find the care you need below." image="/images/heel-pain-exam.jpg">
  <section class="bg-ivory px-6 py-20 lg:px-10 lg:py-28">
    <div class="mx-auto max-w-[1400px]">
      <nav aria-label="Service groups" class="mb-16 flex flex-wrap gap-3">
        {groups.map((g) => <a href={`#${g.toLowerCase().replace(/[^a-z]+/g, '-')}`} class="btn btn-outline !border-navy-900/30 !text-navy-900">{g}</a>)}
      </nav>
      {groups.map((g) => (
        <div id={g.toLowerCase().replace(/[^a-z]+/g, '-')} class="scroll-mt-32 pb-20 last:pb-0">
          <Reveal client:visible>
            <p class="eyebrow">{services.filter((s) => s.group === g).length} services</p>
            <h2 class="mt-3 text-[clamp(2.2rem,4.4vw,3.6rem)] text-navy-900">{g}</h2>
            <p class="mt-3 max-w-xl text-navy-900/70">{intro[g]}</p>
          </Reveal>
          <ul class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
            {services.filter((s) => s.group === g).map((s) => (
              <li id={s.slug}>
                <a href={`/services/${s.slug}`} class="group block">
                  <div class="relative overflow-hidden" style="border-radius:3px">
                    <img src={photo(s.slug)} alt={`${s.title} care`} loading="lazy" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-105" />
                    <div class="absolute inset-0 bg-gradient-to-t from-navy-950/50 via-transparent to-transparent"></div>
                  </div>
                  <h3 class="mt-5 font-serif text-3xl text-navy-900 transition-colors group-hover:text-gold">{s.title}</h3>
                  <p class="mt-2 text-navy-900/70">{s.summary}</p>
                  <span class="mt-3 inline-block text-sm tracking-wide text-gold">Learn more <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
  <section class="bg-navy-950 px-6 py-20 text-center text-white lg:px-10">
    <p class="eyebrow">Not sure where to start?</p>
    <h2 class="mx-auto mt-4 max-w-2xl text-[clamp(2rem,4vw,3.2rem)]">Tell us what hurts. <em class="text-gold">We will guide you.</em></h2>
    <div class="mt-8"><Button book variant="book">Book Appointment</Button></div>
  </section>
  <Contact />
</PageLayout>
